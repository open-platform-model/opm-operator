# GitHub requests a code owner's review on a PR that touches these paths;
# the review is required only where the main ruleset turns on code-owner
# review.
/.github/                       @emil-jacero
/.tasks/                        @emil-jacero
/Taskfile*.yml                  @emil-jacero
/release-please-config.json     @emil-jacero
/.release-please-manifest.json  @emil-jacero
/.cascade-frozen                @emil-jacero
# hack/fixtures.sh, hack/render-config.sh and hack/operator-module/ run in jobs
# that hold write tokens or the release App key.
/hack/                          @emil-jacero
# .opm-cli-version picks the opm binary the fixture and example publish jobs
# (packages: write) install; .opm-docs-version and docs-kit.cue drive the
# signed docs publish (id-token: write) that the site trusts.
/.opm-cli-version               @emil-jacero
/.opm-docs-version              @emil-jacero
/docs-kit.cue                   @emil-jacero
# .golangci-lint-version and .custom-gcl.yml pick the linter binary and its
# plugin that the required Lint job builds and runs.
/.golangci-lint-version         @emil-jacero
/.custom-gcl.yml                @emil-jacero
